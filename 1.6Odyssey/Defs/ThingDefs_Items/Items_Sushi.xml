<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- Simple sushi -->
	<ThingDef ParentName="MealCooked">
		<defName>VCE_Sushi_Simple</defName>
		<label>simple sushi</label>
		<description>A sushi tray made from a few ingredients. Nigirizushi consists of an oblong mound of sushi rice that the chef presses between the palms of the hands to form an oval-shaped ball, and a topping (the neta) draped over the ball.</description>
		<graphicData>
			<texPath>Things/Meals/VCE_Sushi_Simple</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>15</MarketValue>
			<WorkToMake>300</WorkToMake>
			<Nutrition>0.9</Nutrition>
		</statBases>
		<rotatable>false</rotatable>
		<ingestible>
			<preferability>MealSimple</preferability>
			<tasteThought>VCE_AteSimpleSushi</tasteThought>
			<ingestEffect>EatVegetarian</ingestEffect>
			<ingestSound>Meal_Eat</ingestSound>
		</ingestible>
	</ThingDef>
	<!-- Fine sushi -->
	<ThingDef ParentName="MealCooked">
		<defName>VCE_Sushi_Fine</defName>
		<label>fine sushi</label>
		<description>Complex norimaki sushi assembled with care from a wide selection of ingredients. Norimaki are a type of cylindrical sushi wrapped in seaweed.</description>
		<graphicData>
			<texPath>Things/Meals/VCE_Sushi_Fine</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>20</MarketValue>
			<WorkToMake>450</WorkToMake>
			<Nutrition>1</Nutrition>
		</statBases>
		<rotatable>false</rotatable>
		<ingestible>
			<preferability>MealFine</preferability>
			<tasteThought>VCE_AteFineSushi</tasteThought>
			<ingestEffect>EatVegetarian</ingestEffect>
			<ingestSound>Meal_Eat</ingestSound>
		</ingestible>
	</ThingDef>
	<!-- Lavish sushi -->
	<ThingDef ParentName="MealCooked">
		<defName>VCE_Sushi_Lavish</defName>
		<label>lavish sushi</label>
		<description>A masterpiece of the culinary arts, this sushi nourishes the body, mind, and soul. Uramaki is a medium-sized cylindrical piece with two or more fillings, and it differs from other maki because the rice is on the outside and the nori seaweed inside.</description>
		<graphicData>
			<texPath>Things/Meals/VCE_Sushi_Lavish</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>40</MarketValue>
			<WorkToMake>800</WorkToMake>
			<Nutrition>1</Nutrition>
		</statBases>
		<rotatable>false</rotatable>
		<ingestible>
			<preferability>MealLavish</preferability>
			<tasteThought>VCE_AteLavishSushi</tasteThought>
			<ingestEffect>EatVegetarian</ingestEffect>
			<ingestSound>Meal_Eat</ingestSound>
		</ingestible>
	</ThingDef>
	<!-- Gourmet sushi-->
	<ThingDef ParentName="MealCooked">
		<defName>VCE_Sushi_Gourmet</defName>
		<label>gourmet sushi</label>
		<description>A culinary work of art, characterized by refined, even elaborate preparation and presentation of an aesthetically balanced, albeit low quantity sushi.</description>
		<thingClass>VEF.Cooking.GourmetMeal</thingClass>
		<graphicData>
			<texPath>Things/Meals/VCE_Sushi_Gourmet</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>70</MarketValue>
			<WorkToMake>1500</WorkToMake>
			<Nutrition>0.7</Nutrition>
		</statBases>
		<rotatable>false</rotatable>
		<ingestible>
			<preferability>MealLavish</preferability>
			<optimalityOffsetHumanlikes>20</optimalityOffsetHumanlikes>
			<tasteThought>VCE_AteGourmetSushi</tasteThought>
			<ingestEffect>EatVegetarian</ingestEffect>
			<ingestSound>Meal_Eat</ingestSound>
		</ingestible>
	</ThingDef>
</Defs>
